# Generated by Cargo
# will prevent Cargo's output directories from being tracked.
/target
nuralnet/target

# Rust artifacts
# Specifies common Rust build artifacts that should not be tracked.
*.rlib
*.d
*.so
*.dylib
*.exe
*.pdb
*.profdata
/out

# General editor files
#  Excludes editor-specific temporary files and backups.
.DS_Store
*.swp
*.swo
*~
.vscode/
/build

# Test & Coverage
# Files generated during testing and coverage analysis.
/coverage
/test_results.xml
gc.profraw
/target/llvm-profile/

# Dependency directories (if you use e.g. local git dependencies)
#  For excluding any locally checked out dependencies.
/deps

# General purpose ignores
#  Catches various other temporary files or directories.
/tmp
/temp
*.log
/build_scripts
/dist

# If you are using Nix
result

# If you are using cargo-make
/out

# If you are using the `wasm-pack build` command.
/pkg

# Include crash reports, these are helpful, but can be large.  Remove this line if you
# don't want them included.
# *.crash

# Exclude lockfiles generated by cross
cross-tool-cache
